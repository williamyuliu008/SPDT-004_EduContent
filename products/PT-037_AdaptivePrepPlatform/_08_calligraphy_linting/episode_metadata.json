{
  "episodes": [
    {
      "id": "ep01",
      "title": "乾元元年·蒲州的墨与血",
      "theme": "颜真卿与安史之乱",
      "subtitle": "盛唐的背影：一位忠臣的笔下山河",
      "audio_file": "Ep01_天朝崩塌.mp3",
      "audio_path": "D:\\92_products\\SPDT-004_EduContent\\PT-038_TextExperience\\audio\\Ep01_天朝崩塌.mp3",
      "calligraphy_image": "颜真卿祭侄文稿.jpg",
      "practice_duration": 15,
      "script_text": "乾元元年，公元758年。蒲州城头的风，带着黄河的潮湿与战火的焦味。唐代书法家颜真卿站在城垛上，望着远方安禄山叛军压境的狼烟。这一年，他四十九岁，官居蒲州刺史，距离那场改变大唐命运的安史之乱，已经过去了整整五年。颜氏一门，在这个乱世中，用鲜血与忠义，书写了中国书法史上最悲壮的一页。",
      "timestamps": [
        {"time": 0,   "text": "【卷首语】", "scene": "引子"},
        {"time": 12,  "text": "乾元元年，公元758年。", "scene": "时间标记"},
        {"time": 25,  "text": "蒲州城头的风，带着黄河的潮湿与战火的焦味。", "scene": "场景描写"},
        {"time": 42,  "text": "唐代书法家颜真卿站在城垛上，望着远方安禄山叛军压境的狼烟。", "scene": "人物出场"},
        {"time": 62,  "text": "这一年，他四十九岁，官居蒲州刺史。", "scene": "人物介绍"},
        {"time": 78,  "text": "距离那场改变大唐命运的安史之乱，已经过去了整整五年。", "scene": "历史背景"},
        {"time": 95,  "text": "天宝十四载，公元755年冬天，安禄山在范阳起兵。", "scene": "安史之乱爆发"},
        {"time": 115, "text": "渔阳鼙鼓动地来，惊破霓裳羽衣曲。", "scene": "诗歌引用"},
        {"time": 135, "text": "洛阳、长安相继沦陷，唐玄宗仓皇西逃。", "scene": "长安沦陷"},
        {"time": 155, "text": "颜氏一门，在这场浩劫中遭受了灭顶之灾。", "scene": "颜氏家族"},
        {"time": 175, "text": "颜真卿的兄长颜杲卿，时任常山太守，率先起兵反抗。", "scene": "颜杲卿起义"},
        {"time": 198, "text": "常山城破之日，颜杲卿被俘，骂贼不屈，被割舌而死。", "scene": "颜杲卿殉国"},
        {"time": 220, "text": "他的侄子颜季明，也在这场战乱中被杀害，头颅被悬于城门。", "scene": "颜季明遇难"},
        {"time": 245, "text": "直到战后，颜真卿才派人寻访，僅找回侄子的头骨。", "scene": "战后寻访"},
        {"time": 270, "text": "乾元元年，颜真卿命人前往洛阳，终于迎回了兄长的灵柩。", "scene": "迎回灵柩"},
        {"time": 295, "text": "悲愤交加之下，他提笔写下了那篇流传千古的《祭侄文稿》。", "scene": "书写契机"},
        {"time": 318, "text": "这篇文稿，被后世誉为「天下第二行书」。", "scene": "书法地位"},
        {"time": 338, "text": "全篇涂改之处甚多，笔锋时而急促、时而凝重，", "scene": "文稿特点（一）"},
        {"time": 360, "text": "字里行间，是一个侄子对兄长一家的无尽哀思。", "scene": "文稿特点（二）"},
        {"time": 385, "text": "颜真卿的楷书端庄雄伟，骨力遒劲；", "scene": "书法风格（一）"},
        {"time": 408, "text": "而他的行草书，则是在这乱世中磨砺出的另一面——", "scene": "书法风格（二）"},
        {"time": 430, "text": "悲壮、沉郁、忠义满腔。", "scene": "书法风格（三）"},
        {"time": 452, "text": "建中四年，公元783年，淮西节度使李希烈叛乱。", "scene": "晚年遭遇"},
        {"time": 475, "text": "年过七旬的颜真卿，奉命前往劝谕，被李希烈扣押。", "scene": "被扣留"},
        {"time": 498, "text": "他宁死不屈，最终被缢杀于狱中，享年七十六岁。", "scene": "英勇就义"},
        {"time": 522, "text": "一个人，在盛唐的背影里，以笔为刀，以墨为血。", "scene": "结语（一）"},
        {"time": 545, "text": "他写的不仅是字，更是一个时代最后的脊梁。", "scene": "结语（二）"},
        {"time": 568, "text": "【临帖要点】执笔宜正锋，行笔宜沉稳，", "scene": "临帖指导（一）"},
        {"time": 590, "text": "学颜体，须先学其人，再学其字。", "scene": "临帖指导（二）"},
        {"time": 615, "text": "忠义之气，贯于笔端，此为颜体之魂。", "scene": "临帖指导（三）"}
      ],
