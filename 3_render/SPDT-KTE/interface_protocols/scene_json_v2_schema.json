{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://spdt-kte/schemas/scene_json_v2.schema.json",
  "title": "SPDT-KTE Interface A · scene_json_v2",
  "description": "PT-038 → PT-VFX 场景 JSON 协议 v2.0.0。PT-038 的 episode .py 经 PT038_to_VideoFactory.py 转换后输出为此格式，PT-VFX 渲染引擎消费此 JSON 渲染 Pillow 帧。\n[OMA S MODLIB 同步副本] D:/1_omas/MODLIB/content_manufacturing/interface_protocols/IF-A_scene_json_v2.schema.json",
  "version": "2.0.0",
  "interface_id": "IF-A",
  "producer": "PT-038",
  "consumer": "PT-VFX",
  "frozen": true,
  "breaking_change_requires": "major version increment + 2-week compatibility window",

  "type": "object",
  "required": ["scenes", "metadata"],

  "properties": {
    "metadata": {
      "type": "object",
      "required": ["series_title", "ep_id", "ep_title", "source_chain_id"],
      "properties": {
        "series_title": {
          "type": "string",
          "description": "系列标题，如"墨骨山河""
        },
        "ep_id": {
          "type": "integer",
          "description": "集数编号，1-based"
        },
        "ep_title": {
          "type": "string",
          "description": "集标题，如"乾元元年·蒲州的墨与血""
        },
        "source_chain_id": {
          "type": "string",
          "description": "来源知识链 ID，如"墨骨山河_ep01""
        },
        "source_pt": {
          "type": "string",
          "const": "PT-038"
        },
        "schema_version": {
          "type": "string",
          "const": "2.0.0"
        }
      }
    },

    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scene_id", "scene_type", "content", "source_knowledge_nodes"],
        "properties": {
          "scene_id": {
            "type": "string",
            "pattern": "^scene_[0-9]{3}$",
            "description": "场景编号，格式：scene_001, scene_002 ..."
          },
          "scene_type": {
            "type": "string",
            "enum": [
              "title", "concept", "contrast", "steps", "action",
              "summary", "quote_highlight", "timeline",
              "analogy_scene",    // v2 新增
              "dual_track"
            ],
            "description": "Pillow 渲染模板类型"
          },
          "content": {
            "type": "object",
            "description": "渲染参数，具体字段因 scene_type 而异，参见 PT-VFX scene_renderer_pillow.py",
            "properties": {
              "title": { "type": "string", "maxLength": 30 },
              "subtitle": { "type": "string", "maxLength": 50 },
              "keywords": {
                "type": "array",
                "items": { "type": "string" },
                "maxItems": 6
              },
              "labels": {
                "type": "array",
                "items": { "type": "string" },
                "maxItems": 6
              },
              "chain_items": {
                "type": "array",
                "items": { "type": "string" },
                "maxItems": 5
              },
              "text": { "type": "string", "maxLength": 200 },
              "quote": { "type": "string", "maxLength": 100 },
              "quote_author": { "type": "string", "maxLength": 20 },
              "quote_highlight": { "type": "string", "maxLength": 20 }
            }
          },

          "source_knowledge_nodes": {
            "type": "array",
            "description": "本 scene 对应的知识节点，用于 PT-VFX 渲染时校验与 PT-038 知识库的对齐",
            "items": { "type": "string" },
            "example": ["书法/唐/颜真卿", "历史/唐/安史之乱"]
          },

          "source_chain_id": {
            "type": "string",
            "description": "来源知识链 ID"
          },

          "page": {
            "type": "object",
            "properties": {
              "start": { "type": "number" },
              "duration": { "type": "number" }
            }
          },

          "scene_info": {
            "type": "object",
            "properties": {
              "idx": { "type": "integer" },
              "total": { "type": "integer" },
              "name": { "type": "string" },
              "dur": { "type": "number" }
            }
          },

          // ── v2 新增字段 ─────────────────────────────

          "knowledge_type": {
            "type": "string",
            "enum": ["I", "II", "III", "IV"],
            "description": "知识类型（类比适用性）：I=强类比适用，II=受限类比，III=结构推导，IV=事实性。PT-VFX据此决定是否启用 analogy_scene 模板。"
          },

          "emotion_trigger": {
            "type": "string",
            "enum": ["curiosity", "resonance", "solemnity", "sober_reflection", "none"],
            "description": "本 scene 触发的受蕴情绪类型。PT-VFX 渲染时据此选择视觉色调/动效基调。"
          },

          "analogy_block": {
            "type": "object",
            "description": "类比通道数据。knowledge_type 为 I 或 II 时必须有值。",
            "required": ["source_domain", "target_domain", "mapping_table"],
            "properties": {
              "applicable": { "type": "boolean" },
              "type": {
                "type": "string",
                "enum": ["I", "II"]
              },
              "source_domain": {
                "type": "string",
                "description": "源域（学生已知的经验），如"战场杀伐"",
                "maxLength": 50
              },
              "target_domain": {
                "type": "string",
                "description": "目标域（待学知识），如"颜体书法的力量感"",
                "maxLength": 50
              },
              "mapping_table": {
                "type": "array",
                "description": "结构映射表，每项对应一条核心关系对应",
                "items": {
                  "type": "object",
                  "properties": {
                    "from": { "type": "string" },
                    "to": { "type": "string" },
                    "relation": { "type": "string" }
                  }
                }
              },
              "difference_annotations": {
                "type": "array",
                "description": "差异标注（II 型强制），逐条说明类比与真实的差异",
                "items": { "type": "string" }
              }
            }
          },

          "five_skandha": {
            "type": "object",
            "description": "五蕴认知链标注。本字段为 PT-VFX 提供渲染认知锚点，PT-RUJ 消费此字段提供学习引导。",
            "required": ["color_base", "discrimination", "action_prompt"],
            "properties": {
              "color_base": {
                "type": "string",
                "description": "本 scene 的色尘锚点（视觉关键词），PT-VFX 渲染时须在帧中突出显示",
                "maxLength": 100
              },
              "sensation": {
                "type": "string",
                "enum": ["curiosity", "resonance", "solemnity", "sober_reflection", "neutral"],
                "description": "预期的受蕴情绪类型，与 emotion_trigger 一致"
              },
              "discrimination": {
                "type": "string",
                "description": "本 scene 对应的想蕴分别点（学习者应该能区分的概念边界）",
                "maxLength": 150
              },
              "action_prompt": {
                "type": "string",
                "description": "行蕴触发提示，引导学习者主动输出的任务（填空/判断/口述）",
                "maxLength": 200
              },
              "recognition_marker": {
                "type": "string",
                "description": "识蕴落成检验关键词，PT-RUJ Flashcard 判断"熟"的依据之一",
                "maxLength": 50
              }
            }
          },

          "semantic_alignment": {
            "type": "object",
            "description": "声尘-色尘语义对齐标注。PT-VFX 渲染时必须校验此字段的完整性。",
            "properties": {
              "audio_segment_ref": {
                "type": "string",
                "description": "对应旁白文本段落的引用 ID，格式如"FT001-NARR-02"",
                "pattern": "^[A-Z0-9_-]+$"
              },
              "visual_element_ref": {
                "type": "string",
                "description": "本 scene content 中的哪个字段对应这段旁白",
                "example": "CONTENT-ZONE-2"
              },
              "alignment_note": {
                "type": "string",
                "description": "对齐说明，描述声尘和色尘如何语义对应",
                "maxLength": 200
              }
            }
          },

          "cognitive_load": {
            "type": "object",
            "description": "认知负荷元数据。PT-VFX scene_quality_gate G06 读取此字段。",
            "properties": {
              "points_count": {
                "type": "integer",
                "maximum": 4,
                "description": "本 scene 的独立信息点数量。工作记忆约束：≤4。"
              },
              "warning": {
                "type": "boolean",
                "description": "若 points_count > 4，PT-VFX 渲染器应报警并建议拆分 scene。"
              }
            }
          }
        }
      }
    }
  },

  "examples": [
    {
      "metadata": {
        "series_title": "墨骨山河",
        "ep_id": 1,
        "ep_title": "乾元元年·蒲州的墨与血",
        "source_chain_id": "墨骨山河_ep01",
        "source_pt": "PT-038",
        "schema_version": "2.0.0"
      },
      "scenes": [
        {
          "scene_id": "scene_001",
          "scene_type": "title",
          "content": {
            "title": "乾元元年·蒲州的墨与血",
            "subtitle": "颜真卿与安史之乱"
          },
          "source_knowledge_nodes": ["书法/唐/颜真卿", "历史/唐/安史之乱"],
          "source_chain_id": "墨骨山河_ep01",
          "knowledge_type": "IV",
          "emotion_trigger": "solemnity",
          "five_skandha": {
            "color_base": "乾元元年 · 蒲州 · 墨与血",
            "sensation": "solemnity",
            "discrimination": "本集定位：书法史×战争史的双线交织",
            "action_prompt": "默写：安史之乱爆发年份？",
            "recognition_marker": "蒲州"
          },
          "cognitive_load": { "points_count": 2 }
        },
        {
          "scene_id": "scene_003",
          "scene_type": "analogy_scene",
          "content": {
            "title": "刀锋入纸：书法的战场基因",
            "keywords": ["杀伐气", "筋骨", "军旅生涯"]
          },
          "source_knowledge_nodes": ["书法/唐/颜真卿/书风", "书法/审美/力量感"],
          "source_chain_id": "墨骨山河_ep01",
          "knowledge_type": "II",
          "emotion_trigger": "resonance",
          "analogy_block": {
            "applicable": true,
            "type": "II",
            "source_domain": "战场杀伐",
            "target_domain": "颜体书法的力量感",
            "mapping_table": [
              { "from": "刀痕的力量感", "to": "颜体筋骨之力", "relation": "具象→抽象" },
              { "from": "血肉横飞", "to": "墨色焦渴", "relation": "视觉→触觉" }
            ],
            "difference_annotations": [
              "刀痕是金属划过皮肤的破坏性行为，笔锋是毛笔弹性与纸面摩擦的建构性行为",
              "刀痕不可逆，笔锋可随提按产生浓淡枯润变化"
            ]
          },
          "five_skandha": {
            "color_base": "关键词：杀伐气 · 筋骨 · 蒲州军旅",
            "sensation": "resonance",
            "discrimination": "能区分"颜体力量感"与"二王秀美"的不同来源",
            "action_prompt": "判断：以下哪句描述的是颜体特征？",
            "recognition_marker": "蒲州 · 军旅"
          },
          "semantic_alignment": {
            "audio_segment_ref": "FT001-NARR-03",
            "visual_element_ref": "KEYWORDS",
            "alignment_note": "旁白讲"墨色焦渴如血痕"时，视觉区高亮"杀伐气"关键词"
          },
          "cognitive_load": { "points_count": 3 }
        }
      ]
    }
  ]
}
