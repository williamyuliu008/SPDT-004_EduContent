# PT-030 toolkit 路径配置示例
# 复制为 config.yaml 后, 按需修改路径
# 路径优先级: 环境变量 PT030_<KEY> > 此文件 > 代码默认值

# 宇兄端默认 (D:\\) - 雪薇端可改为 /Users/xuewei/data/... 或其他

# 原始试卷解析输出 (parse_pdf / parse_docx / parse_doc)
# 命名: <年份>_<学科>_raw.json
raw_dir: D:/4_data/rujing_out/真题主库/raw

# 题目切分输出 (split_questions_v11)
# 命名: <年份>_<学科>_split.json
split_dir: D:/4_data/rujing_out/真题主库/split

# 真题主库目录 (学习中心 zhenti/ 索引)
zhenti_dir: D:/4_data/rujing_out/真题主库/zhenti

# 知识卡片目录 (4 步法 数学/历史/...)
handbook_dir: D:/4_data/knowledge_cards

# PT-030 项目根目录 (PT-030_GaokaoPrep)
pt030_root: D:/2_products/education/PT-030_GaokaoPrep

# GLM API key (智谱 AI) - 也可设环境变量 ZHIPU_API_KEY
# glm5_api_key: "your_key_here"
# glm4_flash_api_key: "your_key_here"

# LLM 配额
llm:
  glm5_max_concurrent: 3
  glm4_flash_max_concurrent: 5
  glm5_timeout_seconds: 30
  glm4_flash_timeout_seconds: 20
